{
  "name": "@emo-eth/hyper-questions-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "pi-package",
    "omp-package",
    "questions",
    "interview"
  ],
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/omp.ts"
    ]
  },
  "exports": {
    ".": "./src/host.ts",
    "./pi": "./src/pi.ts",
    "./omp": "./src/omp.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
