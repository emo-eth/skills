{
  "name": "@emo-eth/advisor-profiles-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "pi-package",
    "advisor-profiles",
    "watchdog",
    "review"
  ],
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "exports": {
    ".": "./src/config.ts",
    "./pi": "./src/pi.ts",
    "./review": "./src/review.ts",
    "./state": "./src/state.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "npm run test:node",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
