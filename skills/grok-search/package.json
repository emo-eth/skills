{
  "name": "@emo-eth/grok-search-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "pi-package",
    "omp-package",
    "grok",
    "x-search",
    "web-search"
  ],
  "pi": {
    "extensions": [
      "./src/pi.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/omp.ts"
    ]
  },
  "exports": {
    ".": "./src/host.ts",
    "./pi": "./src/pi.ts",
    "./omp": "./src/omp.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "npm run test:node && npm run test:pi-runner && npm run test:omp-runner",
    "test:node": "node --experimental-strip-types --test tests/*.test.ts",
    "test:pi-runner": "bun test ./tests/native-pi-runner.bun.ts",
    "test:omp-runner": "bun test ./tests/native-omp-runner.bun.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@oh-my-pi/pi-coding-agent": "17.2.15",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
